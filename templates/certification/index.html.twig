{% extends 'base.html.twig' %}

{% block title %}Mes certifications{% endblock %}

{% block body %}

<div class="kl-container">
    <h1>Mes certifications</h1>
    {% for certification in certifications %}
        <div>
            <h2>{{ certification.theme.title }}</h2>
            <p>Obtenue le {{ certification.obtainedAt|date('d/m/Y') }}</p>
        </div>
    {% else %}
        <p>Aucune certification obtenue.</p>
    {% endfor %}
</div>
{% endblock %}
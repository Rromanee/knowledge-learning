{% extends 'base.html.twig' %}

{% block title %}{{ course.title }}{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <div class="alert alert-success">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('warning') %}
    <div class="alert alert-warning">
        {{ message }}
    </div>
{% endfor %}
 
<div class="kl-container">
    <h1 class="kl-title">{{ course.title }}</h1>

    <div class="kl-grid">
        {% for lesson in course.lessons %}
            <a href="{{  path('app_lesson', {id: lesson.id}) }}" class="kl-card">
                <h3>{{ lesson.title }}</h3>
                    <p class="kl-price">{{ lesson.price }} €</p>
            </a>

        {% if lesson.id in purchasedLessons %}
            <span class="text-success">Achetée</span>
        {% else %}
            <a href="{{ path('app_lesson_buy', {id: lesson.id}) }}">
                Acheter cette leçon
             </a>
        {% endif %}
        
        {% else %}
            <p>Aucun cursus disponible.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
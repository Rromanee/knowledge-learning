{% extends 'base.html.twig' %}

{% block title %}{{ course.title }} - Knowledge Learning{% endblock %}

{% block meta_description %}
    Découvrez le cours {{ course.title }} et ses leçons sur Knowledge Learning.
{% endblock %}

{% block body %}

<div class="kl-container">

    <nav aria-label="Fil d'Ariane" class="mb-3">

        <a href="{{ path('app_home') }}">
            Accueil
        </a>

        <span aria-hidden="true">
            &gt;
        </span>

        <a href="{{ path('app_theme', {id: course.theme.id}) }}">
            {{ course.theme.title }}
        </a>

        <span aria-hidden="true">
            &gt;
        </span>

        <span aria-current="page">
            {{ course.title }}
        </span>

    </nav>

    <h1 class="kl-title">{{ course.title }}</h1>

    <div class="kl-grid">

        {% for lesson in course.lessons %}

            <a
                href="{{ path('app_lesson', {id: lesson.id}) }}"
                class="kl-card"
            >

                <h2>{{ lesson.title }}</h2>

                <p class="kl-price">
                    {{ lesson.price }} €
                </p>

            </a>

            {% if coursePurchased or lesson.id in purchasedLessons %}

                <span class="text-success">
                    ✓ Accessible
                </span>

            {% else %}

                <a href="{{ path('app_lesson_buy', {id: lesson.id}) }}">
                    Acheter cette leçon
                </a>

            {% endif %}

        {% else %}

            <p>Aucune leçon disponible.</p>

        {% endfor %}

    </div>

</div>

{% endblock %}
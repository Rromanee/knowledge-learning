{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}

<div class="kl-auth-container">

    <h1 class="kl-title">{{ title }}</h1>

    {{ form_start(form, {'attr': {'class': 'kl-auth-form'}}) }}

        <div class="mb-3">
            {{ form_row(form.title, {
                label: 'Titre'
            }) }}
        </div>

        <div class="mb-3">
            {{ form_row(form.price, {
                label: 'Prix'
            }) }}
        </div>

        <div class="mb-3">
            {{ form_row(form.theme, {
                label: 'Thème'
            }) }}
        </div>

        <div class="mt-4">

            <button
                type="submit"
                class="btn btn-primary w-100"
            >
                Enregistrer
            </button>

            <a
                href="{{ path('app_admin_courses') }}"
                class="btn btn-secondary w-100 mt-2"
            >
                ← Retour à la liste
            </a>

        </div>

    {{ form_end(form) }}

</div>

{% endblock %}
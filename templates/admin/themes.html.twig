{% extends 'base.html.twig' %}

{% block title %}Gestion des thèmes{% endblock %}

{% block body %}

<div class="kl-container">

    <h1 class="kl-title">Gestion des thèmes</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success auto-dismiss-alert">
            {{ message }}
        </div>
    {% endfor %}

    <div class="text-center mb-4">

        <a
            href="{{ path('app_admin_theme_new') }}"
            class="btn btn-primary"
        >
            Créer un thème
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Date de création</th>
                    <th>Date de modification</th>
                    <th>Créé par</th>
                    <th>Modifié par</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                {% for theme in themes %}

                    <tr>

                        <td>
                            {{ theme.id }}
                        </td>

                        <td>
                            {{ theme.title }}
                        </td>

                        <td>
                            {{ theme.createdAt ? theme.createdAt|date('d/m/Y H:i') : '-' }}
                        </td>

                        <td>
                            {{ theme.updatedAt ? theme.updatedAt|date('d/m/Y H:i') : '-' }}
                        </td>

                        <td>
                            {{ theme.createdBy ?: '-' }}
                        </td>

                        <td>
                            {{ theme.updatedBy ?: '-' }}
                        </td>

                        <td>

                            <a
                                href="{{ path('app_admin_theme_edit', {id: theme.id}) }}"
                                class="btn btn-primary btn-sm"
                            >
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_admin_theme_delete', {id: theme.id}) }}"
                                class="d-inline"
                                onsubmit="return confirm('Supprimer ce thème ?')"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_theme_' ~ theme.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm"
                                >
                                    Supprimer
                                </button>

                            </form>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="7" class="text-center">
                            Aucun thème trouvé.
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

    <div class="text-center mt-4">

        <a
            href="{{ path('app_admin') }}"
            class="btn btn-secondary"
        >
            ← Retour au backoffice
        </a>

    </div>

</div>

{% endblock %}
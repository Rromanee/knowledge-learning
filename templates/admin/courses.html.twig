{% extends 'base.html.twig' %}

{% block title %}Gestion des cursus{% endblock %}

{% block body %}

<div class="kl-container">

    <h1 class="kl-title">Gestion des cursus</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success auto-dismiss-alert">
            {{ message }}
        </div>
    {% endfor %}

    <div class="text-center mb-4">

        <a
            href="{{ path('app_admin_course_new') }}"
            class="btn btn-primary"
        >
            Créer un cursus
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Prix</th>
                    <th>Thème</th>
                    <th>Date de création</th>
                    <th>Date de modification</th>
                    <th>Créé par</th>
                    <th>Modifié par</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                {% for course in courses %}

                    <tr>

                        <td>
                            {{ course.id }}
                        </td>

                        <td>
                            {{ course.title }}
                        </td>

                        <td>
                            {{ course.price }} €
                        </td>

                        <td>
                            {{ course.theme.title }}
                        </td>

                        <td>
                            {{ course.createdAt ? course.createdAt|date('d/m/Y H:i') : '-' }}
                        </td>

                        <td>
                            {{ course.updatedAt ? course.updatedAt|date('d/m/Y H:i') : '-' }}
                        </td>

                        <td>
                            {{ course.createdBy ?: '-' }}
                        </td>

                        <td>
                            {{ course.updatedBy ?: '-' }}
                        </td>

                        <td class="text-nowrap">

                            <a
                                href="{{ path('app_admin_course_edit', {id: course.id}) }}"
                                class="btn btn-primary btn-sm me-2"
                            >
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_admin_course_delete', {id: course.id}) }}"
                                class="d-inline"
                                onsubmit="return confirm('Supprimer ce cursus ?')"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_course_' ~ course.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm"
                                >
                                    Supprimer
                                </button>

                            </form>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="9" class="text-center">
                            Aucun cursus trouvé.
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

    <div class="text-center mt-4">

        <a
            href="{{ path('app_admin') }}"
            class="btn btn-secondary"
        >
            ← Retour au backoffice
        </a>

    </div>

</div>

{% endblock %}
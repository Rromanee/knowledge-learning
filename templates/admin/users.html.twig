{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}

<div class="kl-container">

    <h1 class="kl-title">Gestion des utilisateurs</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success auto-dismiss-alert">
            {{ message }}
        </div>
    {% endfor %}

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Vérifié</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                {% for user in users %}

                    <tr>

                        <td>
                            {{ user.id }}
                        </td>

                        <td>
                            {{ user.email }}
                        </td>

                        <td>
                            {{ user.roles|join(', ') }}
                        </td>

                        <td>
                            {% if user.isVerified %}
                                Oui
                            {% else %}
                                Non
                            {% endif %}
                        </td>

                        <td class="text-nowrap">

                            <a
                                href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                                class="btn btn-primary btn-sm me-2"
                            >
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                class="d-inline"
                                onsubmit="return confirm('Supprimer cet utilisateur ?')"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_user_' ~ user.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm"
                                >
                                    Supprimer
                                </button>

                            </form>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="5" class="text-center">
                            Aucun utilisateur trouvé.
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

    <div class="text-center mt-4">

        <a
            href="{{ path('app_admin') }}"
            class="btn btn-secondary"
        >
            ← Retour au backoffice
        </a>

    </div>

</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}

<div class="kl-container">

<h1 class="kl-title">Backoffice Administration</h1>

<div class="kl-grid">

    <a href="{{ path('app_admin_users') }}" class="kl-card">
        <h2>Gestion des utilisateurs</h2>
        <p>Gérer les comptes utilisateurs.</p>
    </a>

    <a href="{{ path('app_admin_orders') }}" class="kl-card">
        <h2>Gestion des achats</h2>
        <p>Consulter les achats effectués.</p>
    </a>

    <a href="{{ path('app_admin_themes') }}" class="kl-card">
        <h2>Gestion des thèmes</h2>
        <p>Ajouter, modifier ou supprimer les thèmes.</p>
    </a>

    <a href="{{ path('app_admin_courses') }}" class="kl-card">
        <h2>Gestion des cursus</h2>
        <p>Gérer les cursus disponibles.</p>
    </a>

    <a href="{{ path('app_admin_lessons') }}" class="kl-card">
        <h2>Gestion des leçons</h2>
        <p>Gérer les leçons des cursus.</p>
    </a>

</div>

</div>

{% endblock %}